{
    "name": "@openhps/rf",
    "version": "1.0.4",
    "description": "Open Hybrid Positioning System",
    "author": "Maxim Van de Wynckel",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/OpenHPS/openhps-rf.git"
    },
    "bugs": {
        "url": "https://github.com/OpenHPS/openhps-rf/issues"
    },
    "homepage": "https://openhps.org",
    "publishConfig": {
        "access": "public"
    },
    "type": "commonjs",
    "sideEffects": false,
    "main": "./dist/cjs/index.js",
    "types": "./dist/types/index.d.ts",
    "module": "./dist/esm/index.js",
    "es2015": "./dist/esm/index.js",
    "unpkg": "./dist/web/openhps-rf.min.js",
    "jsdelivr": "./dist/web/openhps-rf.min.js",
    "browser": {
        "typescript": false,
        "microtime": false
    },
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*",
        "src/**/*",
        "*.js",
        "*.d.ts"
    ],
    "scripts": {
        "test": "mocha --config test/.mocharc.json",
        "cover": "c8 mocha --config test/.mocharc.json",
        "cover:ci": "c8 mocha --config test/.mocharc.ci.json && c8 report --reporter=cobertura",
        "lint": "eslint . && node scripts/check-peers.mjs",
        "clean": "shx rm -rf ./dist && shx rm -rf ./docs/out",
        "build": "npm run clean && npm-run-all --parallel build:ts:* && npm run build:webpack",
        "build:components": "componentsjs-generator",
        "build:quick": "npm-run-all --parallel build:ts:* && npm run build:webpack",
        "build:typedoc": "typedoc --options docs/typedoc.json",
        "build:ts:cjs": "tsc --build ./tsconfig/tsconfig.bundle.cjs.json",
        "build:ts:esm": "tsc --build ./tsconfig/tsconfig.bundle.esm.json && node ./scripts/finalize-esm.mjs",
        "build:ts:types": "tsc --build ./tsconfig/tsconfig.bundle.types.json",
        "build:webpack": "npm-run-all --parallel build:webpack:*",
        "build:webpack:prod": "webpack --env prod --",
        "build:webpack:dev": "webpack --env dev --",
        "deploy:typedoc": "gh-pages -d ./docs/out",
        "publish:development": "npm run bump:beta && npm publish --tag dev",
        "publish:beta": "npm run bump:beta && npm publish --tag beta",
        "publish:release": "npm run bump:beta && npm publish --tag latest",
        "bump:development": "commit-and-tag-version --prerelease alpha -m 'chore(alpha): %s' --skip.changelog",
        "bump:beta": "commit-and-tag-version --prerelease beta -m 'chore(beta): %s' --skip.changelog",
        "bump:release": "commit-and-tag-version -m 'chore(release): %s' --skip.changelog",
        "prepare": "husky"
    },
    "keywords": [
        "openhps",
        "rf"
    ],
    "dependencies": {
        "ml-levenberg-marquardt": "^4.1.3",
        "ts-md5": "^1.3.1",
        "tslib": "^2.8.1"
    },
    "peerDependencies": {
        "@openhps/core": ">=1.0.16 <2",
        "reflect-metadata": ">=0.2.2 <1"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^19.8.1",
        "@eslint/js": "^9.34.0",
        "@openhps/core": "^1.0.16",
        "@openhps/csv": "0.1.11",
        "@openhps/rdf": "^1.1.7",
        "@types/chai": "^5.2.2",
        "@types/mocha": "^10.0.10",
        "@types/node": "^24.3.0",
        "c8": "^12.0.0",
        "chai": "^6.2.2",
        "commit-and-tag-version": "^13.1.2",
        "eslint": "^9.34.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsdoc": "^54.1.1",
        "eslint-plugin-prettier": "^5.5.4",
        "globals": "^16.3.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.7",
        "mocha": "^11.8.0",
        "mocha-junit-reporter": "^2.2.1",
        "mocha-multi-reporters": "^1.5.1",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.9.6",
        "reflect-metadata": ">=0.1.13",
        "shx": "^0.4.0",
        "terser-webpack-plugin": "^5.3.14",
        "ts-node": "^10.9.2",
        "typedoc": "^0.28.20",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.66.0",
        "webpack": "^5.101.3",
        "webpack-cli": "^6.0.1"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "packageManager": "npm@10.9.2",
    "lsd:module": true,
    "husky": {
        "hooks": {
            "pre-commit": "npm run lint",
            "pre-push": "npm run test",
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    }
}
